---
import Logo from './Logo.astro';
import { t, pathFor, langs, langLabel, type Lang } from '../i18n';
import { CONTACT_EMAIL } from '../config';

interface Props { lang: Lang; current?: string }
const { lang, current = '' } = Astro.props;
const dict = t(lang);

const links = [
  { slug: 'oilfield', label: dict.nav.oilfield },
  { slug: 'coatings', label: dict.nav.coatings },
  { slug: 'agro', label: dict.nav.agro },
  { slug: 'about', label: dict.nav.about },
  { slug: 'contact', label: dict.nav.contact },
];
---
<footer class="footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <Logo inverse />
      <p class="footer-tagline">{dict.footer.tagline}</p>
      <a class="footer-mail u-link" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
    </div>

    <nav class="footer-links" aria-label="Footer">
      {links.map(({ slug, label }) => (
        <a class="u-link" href={pathFor(lang, slug)}>{label}</a>
      ))}
    </nav>

    <div class="footer-langs">
      <span class="label label--inverse">{dict.footer.lang}</span>
      {langs.map((l) => (
        <a class="u-link" href={pathFor(l, current)} lang={l} aria-current={l === lang ? 'true' : undefined}>
          {langLabel[l]}
        </a>
      ))}
    </div>
  </div>
  <div class="container footer-rights">
    <p>{dict.footer.rights}</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--ink);
    color: var(--paper);
    padding-block: var(--space-3xl) var(--space-l);
    margin-top: var(--space-4xl);
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: var(--space-2xl);
    padding-bottom: var(--space-2xl);
    border-bottom: 1px solid color-mix(in srgb, var(--paper) 15%, transparent);
  }
  .footer-tagline { color: color-mix(in srgb, var(--paper) 65%, transparent); margin-block: var(--space-m); max-width: 34ch; }
  .footer-mail { font-size: var(--step--1); color: var(--paper); }
  .footer-links { display: flex; flex-direction: column; gap: var(--space-s); align-items: start; }
  .footer-links a { text-decoration: none; font-size: var(--step-0); }
  .footer-langs { display: flex; flex-direction: column; gap: var(--space-s); align-items: start; }
  .footer-langs a { text-decoration: none; }
  .footer-langs a[aria-current='true'] { color: var(--teal-wash); }
  .label--inverse { color: color-mix(in srgb, var(--paper) 50%, transparent); }
  .footer-rights { padding-top: var(--space-l); }
  .footer-rights p { font-size: var(--step--1); color: color-mix(in srgb, var(--paper) 45%, transparent); }

  @media (max-width: 720px) {
    .footer-grid { grid-template-columns: 1fr; gap: var(--space-xl); }
  }
</style>
