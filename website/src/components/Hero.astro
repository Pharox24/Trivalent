---
import { t, pathFor, type Lang } from '../i18n';
import { c60, labelIndices, LABELS, project } from '../data/molecule3d';

interface Props { lang: Lang }
const { lang } = Astro.props;
const dict = t(lang);

// Build-time static projection of the C60 molecule — the no-JS and
// reduced-motion rendering. The canvas animation covers it when live.
const { verts, edges } = c60();
const labeled = labelIndices(verts);
const VB = 640;
const p = verts.map((v) => project(v, -0.35, 0.6, VB * 0.38, VB / 2, VB / 2));
const staticEdges = edges
  .map(([a, b]) => ({ a: p[a], b: p[b], z: (p[a].z + p[b].z) / 2 }))
  .sort((e1, e2) => e1.z - e2.z);
const depthOf = (z: number) => (z + 1) / 2;
---
<section class="hero">
  <canvas class="hero-canvas" aria-hidden="true"></canvas>

  <div class="hero-visual" aria-hidden="true">
    <div class="hero-mol">
      <svg class="hero-mol3d-svg" viewBox={`0 0 ${VB} ${VB}`}>
        {staticEdges.map(({ a, b, z }) => (
          <line
            x1={a.x.toFixed(1)} y1={a.y.toFixed(1)}
            x2={b.x.toFixed(1)} y2={b.y.toFixed(1)}
            stroke="#7c848e"
            stroke-width={(0.7 + depthOf(z) * 0.9).toFixed(2)}
            opacity={(0.14 + depthOf(z) * 0.66).toFixed(2)}
          />
        ))}
        {p.map((pt, vi) => {
          const d = depthOf(pt.z);
          const r = (1.6 + d * 2.6).toFixed(2);
          return d > 0.82 ? (
            <circle cx={pt.x.toFixed(1)} cy={pt.y.toFixed(1)} r={r} fill="var(--ink)" />
          ) : d > 0.45 ? (
            <circle cx={pt.x.toFixed(1)} cy={pt.y.toFixed(1)} r={r} fill="#7c848e" opacity={(0.25 + d * 0.75).toFixed(2)} />
          ) : (
            <circle cx={pt.x.toFixed(1)} cy={pt.y.toFixed(1)} r={r} fill="var(--paper)" stroke="#7c848e" stroke-width="1" opacity={(0.25 + d * 0.75).toFixed(2)} />
          );
        })}
        {labeled.map((vi, li) =>
          p[vi].z > 0.15 ? (
            <g opacity={Math.min(1, (p[vi].z - 0.15) / 0.5).toFixed(2)}>
              <line
                x1={(p[vi].x + 6).toFixed(1)} y1={(p[vi].y - 6).toFixed(1)}
                x2={(p[vi].x + 16).toFixed(1)} y2={(p[vi].y - 16).toFixed(1)}
                stroke="var(--ink-soft)" stroke-width="0.8"
              />
              <text x={(p[vi].x + 20).toFixed(1)} y={(p[vi].y - 12).toFixed(1)} class="mol-label">{LABELS[li]}</text>
            </g>
          ) : null
        )}
      </svg>
      <canvas class="hero-mol3d"></canvas>
    </div>
  </div>

  <div class="container hero-content">
    <p class="label" data-reveal>{dict.hero.kicker}</p>
    <h1 data-split>
      <span class="hero-line">{dict.hero.line1}</span>
      <span class="hero-line hero-line--strong">{dict.hero.line2}</span>
    </h1>
    <p class="hero-sub" data-reveal data-reveal-delay="0.15">{dict.hero.sub}</p>
    <div data-reveal data-reveal-delay="0.25">
      <a class="btn" href={pathFor(lang, 'contact')} data-magnetic>{dict.hero.cta}</a>
    </div>
  </div>

  <p class="hero-scroll" aria-hidden="true">{dict.hero.scroll}</p>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }

  /* The molecule is anchored inside the hero — it scrolls away with the hero
     content rather than flying off to a corner. Sits behind the headline
     (z-index) and reads as a half-hero backdrop; pointer-events none keeps
     everything beneath it clickable. */
  .hero-visual {
    position: absolute;
    z-index: 1;
    inset: 0;
    pointer-events: none;
  }

  /* The molecule box — right half of the hero, vertically centred. */
  .hero-mol {
    position: absolute;
    top: 50%;
    inset-inline-end: max(2vw, calc(50% - var(--container) / 2));
    /* Viewport-relative so it scales up on large monitors; capped by height so
       it never overruns the hero vertically. */
    width: min(46vw, calc(100svh - 12rem));
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    translate: 0 -50%;
  }
  .hero-mol3d-svg,
  .hero-mol3d {
    grid-area: 1 / 1;
    width: 100%;
    aspect-ratio: 1;
  }
  .hero-mol3d { opacity: 0; }
  .hero.molecule-live .hero-mol3d { opacity: 1; }
  .hero.molecule-live .hero-mol3d-svg { opacity: 0; }
  .mol-label {
    font-family: var(--font-body);
    font-size: 12.5px;
    font-weight: 500;
    fill: var(--ink-soft);
  }
  /* HTML overlay labels created by hero3d.ts (Three.js path) */
  .hero-mol :global(.mol3d-label) {
    position: absolute;
    top: 0;
    left: 0;
    font-family: var(--font-body);
    font-size: 12.5px;
    font-weight: 500;
    color: var(--ink-soft);
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    z-index: 2;
    width: 100%;
    padding-block: var(--space-4xl);
  }
  h1 { margin-block: var(--space-l) var(--space-m); max-width: 22ch; }
  .hero-line { display: block; }
  .hero-line--strong { font-weight: 400; color: var(--teal-deep); }
  html[lang='ar'] .hero-line--strong, html[lang='zh'] .hero-line--strong { font-weight: 700; }
  .hero-sub { max-width: 46ch; color: var(--ink-soft); font-size: var(--step-1); margin-bottom: var(--space-xl); }

  .hero-scroll {
    position: absolute;
    z-index: 2;
    bottom: var(--space-l);
    left: calc(var(--gutter) / 2);
    font-size: var(--step--1);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-soft);
    writing-mode: vertical-rl;
    animation: hero-bob 2.4s var(--ease-in-out-quart) infinite;
  }
  html[dir='rtl'] .hero-scroll { left: auto; right: calc(var(--gutter) / 2); writing-mode: vertical-lr; }
  @keyframes hero-bob {
    0%, 100% { translate: 0 0; }
    50% { translate: 0 8px; }
  }

  @media (max-width: 860px) {
    /* No dock on small screens — molecule is a calm in-hero backdrop */
    .hero-visual { position: absolute; z-index: 1; opacity: 0.3; }
    .hero-mol {
      inset: 0;
      width: 100%;
      height: 100%;
      translate: none;
    }
    html[dir='rtl'] .hero-mol { translate: none; }
    .hero-mol3d-svg, .hero-mol3d { max-height: 78%; }
  }
</style>
