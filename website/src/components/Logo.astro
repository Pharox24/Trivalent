---
interface Props { inverse?: boolean; showWordmark?: boolean }
const { inverse = false, showWordmark = true } = Astro.props;
---
<span class:list={['logo', { 'logo--inverse': inverse }]}>
  <svg viewBox="0 0 32 32" width="28" height="28" aria-hidden="true">
    <g class="logo-bonds" stroke-width="1.6" fill="none">
      <line x1="16" y1="16" x2="16" y2="4" />
      <line x1="16" y1="16" x2="5.6" y2="22" />
      <line x1="16" y1="16" x2="26.4" y2="22" />
    </g>
    <circle class="logo-core" cx="16" cy="16" r="3.2" />
    <circle class="logo-atom" cx="16" cy="4" r="2.2" />
    <circle class="logo-atom" cx="5.6" cy="22" r="2.2" />
    <circle class="logo-atom" cx="26.4" cy="22" r="2.2" />
  </svg>
  {showWordmark && <span class="logo-word">TRIVALENT</span>}
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: 0.6rem; }
  .logo svg { flex: none; }
  .logo-bonds { stroke: var(--teal); }
  .logo-core { fill: var(--teal); }
  .logo-atom { fill: var(--ink); }
  .logo-word {
    font-family: 'IBM Plex Sans', sans-serif;
    font-weight: 600;
    font-size: 0.92rem;
    letter-spacing: 0.24em;
    color: var(--ink);
    translate: 0 0.05em;
  }
  .logo--inverse .logo-atom { fill: var(--paper); }
  .logo--inverse .logo-word { color: var(--paper); }
</style>
