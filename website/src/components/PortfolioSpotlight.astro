---
import { buildGraph, DEFAULT_FOCUS } from '../data/portfolioGraph';
import { t, type Lang } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const dict = t(lang);
const pg = dict.portfolioPage;

const { nodes, index } = buildGraph();
// Every node is shown bilingually: the page-language name as the primary line
// and the complementary language (Chinese on EN/AR pages, English on ZH) as a
// muted sub-line — matching the bilingual source map. Skipped when identical.
const primaryOf = (n: { en: string; zh: string }) => (lang === 'zh' ? n.zh : n.en);
const subOf = (n: { en: string; zh: string }) => {
  const s = lang === 'zh' ? n.en : n.zh;
  return s && s !== primaryOf(n) ? s : '';
};
const label = (id: string) => (index[id] ? primaryOf(index[id]) : id);
const sub = (id: string) => (index[id] ? subOf(index[id]) : '');

// Localised, minified graph for the client.
const clientGraph = nodes.map((n) => ({
  id: n.id,
  label: primaryOf(n),
  sub: subOf(n),
  search: `${n.en} ${n.zh}`.toLowerCase(),
  coverage: n.coverage,
  parents: n.parents,
  children: n.children,
}));

const focus = index[DEFAULT_FOCUS] ?? nodes[0];
const focusParents = focus.parents.map((id) => index[id]).filter(Boolean);
const focusChildren = focus.children.map((id) => index[id]).filter(Boolean);
---
<div
  class="pf2-root"
  data-pf2-root
  data-focus={focus.id}
  data-made-from={pg.madeFrom}
  data-produces={pg.produces}
  data-no-results={pg.noResults}
  data-root={pg.root}
>
  <div class="pf2-searchbar">
    <button type="button" class="pf2-back" data-pf2-back disabled aria-label={pg.back}>
      <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path d="M10 3 5 8l5 5" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
    </button>
    <div class="pf2-searchfield">
      <svg class="pf2-searchicon" viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><circle cx="7" cy="7" r="5" fill="none" stroke="currentColor" stroke-width="1.5" /><path d="m11 11 3 3" stroke="currentColor" stroke-width="1.5" /></svg>
      <input type="search" class="pf2-search" data-pf2-search placeholder={pg.searchPlaceholder} aria-label={pg.searchPlaceholder} autocomplete="off" />
      <div class="pf2-results" data-pf2-results hidden></div>
    </div>
  </div>

  <div class="pf2-stage" data-pf2-stage>
    <div class="pf2-inner" data-pf2-inner>
      <svg class="pf2-svg" data-pf2-svg aria-hidden="true"></svg>

      <!-- SSR fallback (rebuilt by the client script; readable without JS) -->
      <div class="pf2-col pf2-col--left">
        {focusParents.length > 0 && <span class="pf2-colhead">{pg.madeFrom}</span>}
        {focusParents.map((p) => (
          <button type="button" class={`pf2-node pf2-node--${p.coverage} pf2-node--parent`} data-id={p.id}>
            <span class="pf2-label">{label(p.id)}</span>
            {sub(p.id) && <span class="pf2-sub">{sub(p.id)}</span>}
          </button>
        ))}
      </div>
      <div class="pf2-focuswrap">
        <button type="button" class={`pf2-node pf2-node--${focus.coverage} pf2-node--focus`} data-id={focus.id} aria-current="true">
          <span class="pf2-label">{label(focus.id)}</span>
          {sub(focus.id) && <span class="pf2-sub">{sub(focus.id)}</span>}
        </button>
        {focus.parents.length === 0 && <span class="pf2-rootchip">{pg.root}</span>}
      </div>
      <div class="pf2-col pf2-col--right">
        {focusChildren.length > 0 && <span class="pf2-colhead">{pg.produces}</span>}
        {focusChildren.map((c) => (
          <button type="button" class={`pf2-node pf2-node--${c.coverage} pf2-node--child`} data-id={c.id}>
            <span class="pf2-label">{label(c.id)}</span>
            {sub(c.id) && <span class="pf2-sub">{sub(c.id)}</span>}
          </button>
        ))}
      </div>
    </div>
  </div>

  <script type="application/json" data-graph set:html={JSON.stringify(clientGraph)} />

  <!-- SEO / no-JS full index -->
  <ul class="pf2-seo">
    {nodes.map((n) => <li>{lang === 'zh' ? n.zh : n.en}</li>)}
  </ul>
</div>

<style is:global>
  .pf2-root { margin-top: var(--space-xl); }

  .pf2-searchbar { display: flex; gap: var(--space-s); align-items: stretch; margin-bottom: var(--space-l); }
  .pf2-back {
    flex: none;
    width: 3rem;
    display: grid;
    place-items: center;
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: 10px;
    color: var(--ink);
    transition: border-color var(--dur-s) ease, opacity var(--dur-s) ease;
  }
  .pf2-back:disabled { opacity: 0.4; cursor: default; }
  .pf2-back:not(:disabled):hover { border-color: var(--teal); color: var(--teal-deep); }
  html[dir='rtl'] .pf2-back svg { transform: scaleX(-1); }

  .pf2-searchfield { position: relative; flex: 1; max-width: 30rem; }
  .pf2-searchicon {
    position: absolute;
    inset-inline-start: 0.9rem;
    top: 50%;
    translate: 0 -50%;
    color: var(--ink-soft);
    pointer-events: none;
  }
  .pf2-search {
    width: 100%;
    padding: 0.85em 1em 0.85em 2.6em;
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: 10px;
    font: inherit;
    color: var(--ink);
  }
  html[dir='rtl'] .pf2-search { padding: 0.85em 2.6em 0.85em 1em; }
  .pf2-search:focus-visible { outline: none; border-color: var(--teal); box-shadow: 0 0 0 3px var(--teal-wash); }

  .pf2-results {
    position: absolute;
    z-index: 20;
    top: calc(100% + 0.4rem);
    inset-inline: 0;
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: 10px;
    box-shadow: 0 16px 40px rgb(16 21 28 / 0.12);
    padding: var(--space-2xs);
    max-height: 20rem;
    overflow-y: auto;
  }
  .pf2-resitem {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    width: 100%;
    text-align: start;
    padding: 0.6em 0.75em;
    background: none;
    border: 0;
    border-radius: 7px;
    font: inherit;
    font-size: var(--step--1);
    color: var(--ink);
  }
  .pf2-resitem::before { content: ''; width: 9px; height: 9px; border-radius: 3px; flex: none; }
  .pf2-dot--daily::before { background: #f4c430; }
  .pf2-dot--tracked::before { background: var(--teal); }
  .pf2-dot--unit::before { background: var(--ink); }
  .pf2-dot--app::before { background: var(--line); }
  .pf2-resitem:hover { background: var(--teal-wash); color: var(--teal-deep); }
  .pf2-noresult { padding: 0.7em 0.9em; font-size: var(--step--1); color: var(--ink-soft); }

  .pf2-stage {
    position: relative;
    height: min(66vh, 620px);
    overflow: auto;
    background:
      linear-gradient(var(--paper-raised), var(--paper-raised)) padding-box,
      radial-gradient(circle at 1px 1px, var(--line) 1px, transparent 0) 0 0 / 30px 30px;
    border: 1px solid var(--line);
    border-radius: 16px;
    scrollbar-width: thin;
  }
  .pf2-inner {
    position: relative;
    min-height: 100%;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: clamp(1.5rem, 6vw, 5rem);
    padding: var(--space-2xl) var(--space-xl);
  }
  .pf2-svg { position: absolute; inset: 0; pointer-events: none; overflow: visible; }
  .pf2-edge { fill: none; stroke: color-mix(in srgb, var(--teal) 55%, transparent); stroke-width: 1.4; }

  .pf2-col { display: flex; flex-direction: column; gap: var(--space-s); }
  .pf2-col--left { align-items: flex-end; }
  .pf2-col--right { align-items: flex-start; }
  .pf2-colhead {
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-bottom: var(--space-2xs);
  }

  .pf2-focuswrap { display: flex; flex-direction: column; align-items: center; gap: var(--space-s); }
  .pf2-rootchip {
    font-size: var(--step--1);
    color: var(--ink-soft);
    padding: 0.2em 0.7em;
    border: 1px dashed var(--line);
    border-radius: 999px;
  }

  .pf2-node {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1px;
    max-width: 15rem;
    padding: 0.5em 1em;
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: 9px;
    font: inherit;
    font-size: var(--step--1);
    font-weight: 500;
    line-height: 1.2;
    color: var(--ink);
    text-align: center;
    cursor: pointer;
    transition: border-color var(--dur-s) ease, box-shadow var(--dur-s) ease, transform var(--dur-s) ease;
  }
  .pf2-node:hover { border-color: var(--teal); transform: translateY(-2px); box-shadow: 0 8px 22px rgb(16 21 28 / 0.08); }
  .pf2-sub { font-size: 0.8em; font-weight: 400; color: var(--ink-soft); }
  .pf2-node--unit .pf2-sub { color: color-mix(in srgb, var(--paper) 68%, transparent); }
  .pf2-node--daily .pf2-sub { color: #93731a; }

  .pf2-node--daily { background: #fdf3d0; border-color: #e6bd3a; }
  .pf2-node--tracked { border-color: var(--teal); }
  .pf2-node--unit { background: var(--ink); border-color: var(--ink); color: var(--paper); }
  .pf2-node--app { color: var(--ink-soft); }

  .pf2-node--focus {
    z-index: 2;
    max-width: 20rem;
    padding: 0.95em 1.5em;
    font-size: var(--step-1);
    font-weight: 600;
    border-width: 2px;
    border-color: var(--teal);
    box-shadow: 0 14px 40px rgb(13 107 107 / 0.18);
    cursor: default;
  }
  .pf2-node--focus:hover { transform: none; }
  .pf2-node--focus.pf2-node--unit { border-color: var(--ink); }

  /* SEO index hidden from view */
  .pf2-seo {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0);
    white-space: nowrap; border: 0;
  }

  @media (max-width: 720px) {
    .pf2-inner { gap: clamp(1rem, 8vw, 2.5rem); padding: var(--space-xl) var(--space-m); }
    .pf2-node { max-width: 10rem; font-size: 0.8rem; }
    .pf2-node--focus { max-width: 12rem; font-size: var(--step-0); }
  }
</style>
