---
interface Product { name: string; spec: string; apps: string }
interface Props { products: Product[] }
const { products } = Astro.props;
---
<div class="pg-grid">
  {products.map((p, i) => (
    <article class="pg-item" data-reveal data-reveal-delay={(i % 2) * 0.08}>
      <h3 class="pg-name">{p.name}</h3>
      <p class="pg-spec">{p.spec}</p>
      <p class="pg-apps">
        <svg class="pg-bond" viewBox="0 0 18 12" width="18" height="12" aria-hidden="true">
          <line x1="1" y1="6" x2="17" y2="6" stroke="var(--teal)" stroke-width="1.4" />
          <circle cx="3" cy="6" r="2.2" fill="var(--teal)" />
          <circle cx="15" cy="6" r="2.2" fill="none" stroke="var(--teal)" stroke-width="1.4" />
        </svg>
        {p.apps}
      </p>
    </article>
  ))}
</div>

<style>
  .pg-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: var(--space-2xl);
  }
  .pg-item {
    padding-block: var(--space-l);
    border-top: 1px solid var(--line);
  }
  .pg-name { font-size: var(--step-1); margin-bottom: var(--space-2xs); }
  .pg-spec { color: var(--ink-soft); font-size: var(--step--1); letter-spacing: 0.02em; margin-bottom: var(--space-s); }
  .pg-apps {
    display: flex;
    align-items: baseline;
    gap: var(--space-xs);
    font-size: var(--step-0);
  }
  .pg-bond { flex: none; translate: 0 1px; }

  @media (max-width: 720px) {
    .pg-grid { grid-template-columns: 1fr; }
  }
</style>
