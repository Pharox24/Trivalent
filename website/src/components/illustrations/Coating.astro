---
// Thin-line coatings illustration: droplet, layered substrate cross-section, polymer chain.
---
<svg viewBox="0 0 400 400" fill="none" aria-hidden="true" class="illus">
  <!-- Droplet -->
  <g stroke="var(--teal)" stroke-width="1.4">
    <path d="M200 48 C 168 96 152 124 152 152 a48 48 0 0 0 96 0 C 248 124 232 96 200 48 z" />
    <path d="M176 150 a24 26 0 0 0 14 26" stroke-opacity="0.55" />
  </g>
  <!-- Substrate cross-section with three coats -->
  <g stroke="var(--ink)" stroke-width="1.3">
    <rect x="70" y="252" width="260" height="26" />
    <rect x="70" y="278" width="260" height="20" />
    <rect x="70" y="298" width="260" height="34" />
    <!-- top coat sheen -->
    <path d="M78 246 q60 -10 122 0 t122 0" stroke="var(--teal)" stroke-width="1.4" />
  </g>
  <!-- hatching for layers -->
  <g stroke="var(--ink)" stroke-width="1" stroke-opacity="0.4">
    <path d="M84 278 l12 -12 M116 278 l12 -12 M148 278 l12 -12 M180 278 l12 -12 M212 278 l12 -12 M244 278 l12 -12 M276 278 l12 -12 M308 278 l12 -12" />
    <path d="M76 330 l20 -20 M108 332 l24 -24 M144 332 l24 -24 M180 332 l24 -24 M216 332 l24 -24 M252 332 l24 -24 M288 332 l24 -24" stroke-opacity="0.25" />
  </g>
  <!-- Polymer chain -->
  <g stroke="var(--teal)" stroke-width="1.2">
    <path d="M60 180 l28 -16 28 16 28 -16 28 16" />
    <circle cx="60" cy="180" r="4" fill="var(--paper)" />
    <circle cx="88" cy="164" r="4" fill="var(--teal)" stroke="none" />
    <circle cx="116" cy="180" r="4" fill="var(--paper)" />
    <circle cx="144" cy="164" r="4" fill="var(--teal)" stroke="none" />
    <circle cx="172" cy="180" r="4" fill="var(--paper)" />
  </g>
  <!-- Shoe sole outline (footwear PU) -->
  <g stroke="var(--ink)" stroke-width="1.3">
    <path d="M264 190 q30 -14 52 -6 q26 10 20 26 q-4 12 -30 12 h-34 q-14 0 -14 -12 q0 -14 6 -20 z" />
    <path d="M262 214 h72" stroke-opacity="0.5" />
  </g>
</svg>

<style>
  .illus { width: 100%; height: auto; }
</style>
