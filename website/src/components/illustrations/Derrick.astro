---
// Thin-line oilfield illustration: derrick lattice, borehole, barite crystals.
---
<svg viewBox="0 0 400 400" fill="none" aria-hidden="true" class="illus">
  <g stroke="var(--teal)" stroke-width="1.4">
    <!-- Derrick tower -->
    <path d="M150 60 L120 260 M250 60 L280 260" />
    <path d="M150 60 H250" />
    <path d="M143 105 H257 M137 150 H263 M130 195 H270 M124 240 H276" />
    <path d="M143 105 L257 150 M257 105 L143 150 M137 150 L263 195 M263 150 L137 195 M130 195 L270 240 M270 195 L130 240" stroke-opacity="0.55" />
    <!-- Crown & travelling block -->
    <path d="M188 60 V80 M212 60 V80 M188 80 H212" />
    <path d="M200 80 V118" stroke-dasharray="3 4" />
    <rect x="190" y="118" width="20" height="16" rx="2" />
    <!-- Ground -->
    <path d="M60 260 H340" />
    <path d="M80 260 l-8 10 M120 260 l-8 10 M300 260 l-8 10 M338 260 l-8 10" stroke-opacity="0.5" />
    <!-- Borehole -->
    <path d="M192 260 V352 M208 260 V352" />
    <path d="M200 134 V340" stroke-dasharray="2 5" />
    <path d="M196 348 h8" />
  </g>
  <!-- Barite crystal cluster -->
  <g stroke="var(--ink)" stroke-width="1.3">
    <path d="M305 320 l18 -26 20 8 -6 30 -24 4 z" />
    <path d="M323 294 l6 12 -12 22" stroke-opacity="0.6" />
    <path d="M282 332 l12 -16 14 6 -4 18 -16 3 z" />
  </g>
  <!-- Molecule accent -->
  <g stroke="var(--teal)" stroke-width="1.2">
    <path d="M78 96 l30 18 M108 114 l-6 32" />
    <circle cx="78" cy="96" r="4" fill="var(--paper)" />
    <circle cx="108" cy="114" r="5.5" fill="var(--teal)" stroke="none" />
    <circle cx="102" cy="146" r="4" fill="var(--paper)" />
  </g>
</svg>

<style>
  .illus { width: 100%; height: auto; }
</style>
