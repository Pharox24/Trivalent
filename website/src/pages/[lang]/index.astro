---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import ValueChainDiagram from '../../components/ValueChainDiagram.astro';
import DivisionCards from '../../components/DivisionCards.astro';
import CorridorStrip from '../../components/CorridorStrip.astro';
import CtaBand from '../../components/CtaBand.astro';
import { langs, t, type Lang } from '../../i18n';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const dict = t(lang);
---
<Base lang={lang} slug="" title={dict.meta.home.title} desc={dict.meta.home.desc}>
  <Hero lang={lang} />
  <ValueChainDiagram lang={lang} />
  <DivisionCards lang={lang} />
  <CorridorStrip lang={lang} />
  <CtaBand lang={lang} />
</Base>
