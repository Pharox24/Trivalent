---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import ValueChainDiagram from '../../components/ValueChainDiagram.astro';
import { langs, t, type Lang } from '../../i18n';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const dict = t(lang);
---
<Base lang={lang} slug="" title={dict.meta.home.title} desc={dict.meta.home.desc}>
  <Hero lang={lang} />
  <ValueChainDiagram lang={lang} />
  <!-- Remaining home sections assemble in Task 9 -->
</Base>
