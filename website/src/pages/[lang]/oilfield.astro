---
import Base from '../../layouts/Base.astro';
import DivisionPage from '../../components/DivisionPage.astro';
import { langs, t, type Lang } from '../../i18n';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const dict = t(lang);
---
<Base lang={lang} slug="oilfield" title={dict.meta.oilfield.title} desc={dict.meta.oilfield.desc}>
  <DivisionPage lang={lang} division="oilfield" />
</Base>
