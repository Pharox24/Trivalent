---
import Base from '../../layouts/Base.astro';
import PortfolioDiagram from '../../components/PortfolioDiagram.astro';
import { diagrams } from '../../data/portfolio';
import { langs, t, type Lang } from '../../i18n';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const dict = t(lang);
const pg = dict.portfolioPage;
---
<Base lang={lang} slug="portfolio" title={dict.meta.portfolio.title} desc={dict.meta.portfolio.desc}>
  <section class="pf-hero">
    <div class="container">
      <p class="label" data-reveal>{pg.kicker}</p>
      <h1 data-split>{pg.title}</h1>
      <p class="pf-intro" data-reveal>{pg.intro}</p>

      <div class="pf-legend" data-reveal>
        <span class="pf-leg"><i class="pf-sw pf-sw--daily"></i>{pg.legendDaily}</span>
        <span class="pf-leg"><i class="pf-sw pf-sw--tracked"></i>{pg.legendTracked}</span>
        <span class="pf-leg"><i class="pf-sw pf-sw--unit"></i>{pg.legendUnit}</span>
        <span class="pf-leg"><i class="pf-sw pf-sw--app"></i>{pg.legendApp}</span>
      </div>
    </div>
  </section>

  <div class="container pf-body">
    {diagrams.map((diagram) => (
      <div class="pf-group" data-pf-group>
        <div class="pf-controls" data-pf-controls>
          <button type="button" data-act="out" aria-label={pg.zoomOut}>&minus;</button>
          <button type="button" data-act="in" aria-label={pg.zoomIn}>+</button>
          <button type="button" data-act="reset" class="pf-reset">{pg.reset}</button>
          <span class="pf-hint">{pg.hint}</span>
        </div>
        <PortfolioDiagram diagram={diagram} lang={lang} />
      </div>
    ))}
  </div>
</Base>

<style>
  .pf-hero { padding-block: calc(var(--space-4xl) + 4.25rem) var(--space-l); }
  h1 { font-size: var(--step-5); max-width: 20ch; }
  .pf-intro { color: var(--ink-soft); font-size: var(--step-1); max-width: 60ch; margin-top: var(--space-m); }

  .pf-legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-l);
    margin-top: var(--space-xl);
  }
  .pf-leg { display: inline-flex; align-items: center; gap: var(--space-xs); font-size: var(--step--1); color: var(--ink-soft); }
  .pf-sw { width: 16px; height: 16px; border-radius: 4px; flex: none; }
  .pf-sw--daily { background: #f4c430; border: 1px solid #d9a800; }
  .pf-sw--tracked { background: var(--paper-raised); border: 1.5px solid var(--teal); }
  .pf-sw--unit { background: var(--ink); }
  .pf-sw--app { background: var(--paper-raised); border: 1px solid var(--line); }

  .pf-body { padding-bottom: var(--space-4xl); }
  .pf-group { margin-top: var(--space-3xl); }

  .pf-controls {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    margin-bottom: var(--space-s);
  }
  .pf-controls button {
    min-width: 2.4rem;
    height: 2.4rem;
    padding: 0 0.9em;
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: 8px;
    font-size: var(--step-0);
    color: var(--ink);
    transition: border-color var(--dur-s) ease, background var(--dur-s) ease;
  }
  .pf-controls button:hover { border-color: var(--teal); color: var(--teal-deep); }
  .pf-reset { font-size: var(--step--1) !important; }
  .pf-hint { margin-inline-start: auto; font-size: var(--step--1); color: var(--ink-soft); }

  @media (max-width: 640px) {
    .pf-hint { display: none; }
  }
</style>
