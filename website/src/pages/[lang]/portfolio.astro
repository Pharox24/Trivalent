---
import Base from '../../layouts/Base.astro';
import PortfolioSpotlight from '../../components/PortfolioSpotlight.astro';
import { langs, t, type Lang } from '../../i18n';

export function getStaticPaths() {
  return langs.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const dict = t(lang);
const pg = dict.portfolioPage;
---
<Base lang={lang} slug="portfolio" title={dict.meta.portfolio.title} desc={dict.meta.portfolio.desc}>
  <section class="pf-hero">
    <div class="container">
      <p class="label" data-reveal>{pg.kicker}</p>
      <h1 data-split>{pg.title}</h1>
      <p class="pf-intro" data-reveal>{pg.intro}</p>

      <div class="pf-legend" data-reveal>
        <span class="pf-leg"><i class="pf-sw pf-sw--daily"></i>{pg.legendDaily}</span>
        <span class="pf-leg"><i class="pf-sw pf-sw--tracked"></i>{pg.legendTracked}</span>
        <span class="pf-leg"><i class="pf-sw pf-sw--unit"></i>{pg.legendUnit}</span>
        <span class="pf-leg"><i class="pf-sw pf-sw--app"></i>{pg.legendApp}</span>
      </div>

      <a class="pf-download" href="/trivalent-value-chain.pdf" download data-reveal>
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
          <path d="M8 1.5v8m0 0L5 6.5m3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          <path d="M2.5 11v2a1 1 0 0 0 1 1h9a1 1 0 0 0 1-1v-2" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
        {pg.downloadPdf}
      </a>
    </div>
  </section>

  <div class="container pf-body">
    <PortfolioSpotlight lang={lang} />
  </div>
</Base>

<style>
  .pf-hero { padding-block: calc(var(--space-4xl) + 4.25rem) var(--space-l); }
  h1 { font-size: var(--step-5); max-width: 20ch; }
  .pf-intro { color: var(--ink-soft); font-size: var(--step-1); max-width: 60ch; margin-top: var(--space-m); }

  .pf-legend { display: flex; flex-wrap: wrap; gap: var(--space-l); margin-top: var(--space-xl); }
  .pf-leg { display: inline-flex; align-items: center; gap: var(--space-xs); font-size: var(--step--1); color: var(--ink-soft); }
  .pf-sw { width: 16px; height: 16px; border-radius: 4px; flex: none; }
  .pf-sw--daily { background: #f4c430; border: 1px solid #d9a800; }
  .pf-sw--tracked { background: var(--paper-raised); border: 1.5px solid var(--teal); }
  .pf-sw--unit { background: var(--ink); }
  .pf-sw--app { background: var(--paper-raised); border: 1px solid var(--line); }

  .pf-download {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    margin-top: var(--space-xl);
    padding: 0.7em 1.3em;
    background: var(--paper-raised);
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: var(--step--1);
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
    transition: border-color var(--dur-s) ease, color var(--dur-s) ease, transform var(--dur-s) ease;
  }
  .pf-download:hover { border-color: var(--teal); color: var(--teal-deep); transform: translateY(-2px); }
  .pf-download svg { color: var(--teal); }

  .pf-body { padding-bottom: var(--space-4xl); }
</style>
